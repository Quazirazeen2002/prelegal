# Copy to backend/.env for local (non-Docker) development.
# All values have working defaults; override as needed.

# Path to the SQLite database file (recreated from scratch on every app startup).
DB_PATH=data/app.db

# Secret used to sign auth session JWTs. Set an explicit value in any long-lived
# environment — the default is a random value generated at process startup, so
# existing sessions are invalidated on every restart otherwise.
SECRET_KEY=change-me

# Origin allowed to make cross-origin requests (only needed when running the
# Next.js dev server separately from the backend, e.g. `npm run dev` on :3000).
FRONTEND_ORIGIN=http://localhost:3000

# Directory of the built frontend static export to serve at "/". Left unset
# (nonexistent) during local backend-only development.
STATIC_DIR=static
